# Ruta del archivo SQLite.
DATABASE_URL=./local.db

# Carpetas de archivos subidos (ambas ignoradas por git).
RESPONSIVAS_DIR=./responsivas
ENVIOS_DIR=./envios

# Solo producción (adapter-node): tamaño máximo de una petición. Sin esto el
# default es 512 KB y cualquier responsiva escaneada truena con 413.
BODY_SIZE_LIMIT=20M

# De aquí sale el esquema con el que se marcan las cookies de sesión: si empieza
# con https:// la cookie va como Secure. Con http:// (entrada por IP, sin TLS)
# NO debe ir Secure o el navegador la tira y el login rebota sin explicación.
ORIGIN=http://172.10.30.15:1979

# Cuenta de superadmin que crea `npm run db:seed:admin` la primera vez.
# Si se dejan vacías se usa admin/admin y hay que cambiarla al entrar.
ADMIN_USER=
ADMIN_PASSWORD=
